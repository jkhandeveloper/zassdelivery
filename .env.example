# ─────────────────────────────────────────────────────────────
# ZassDelivery API — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1

# Database (PostgreSQL)
# Inside Docker Compose the host is `postgres`; from the host machine it is `localhost`.
# POSTGRES_PORT is the port Compose publishes on the host. Change it if 5432 is
# already taken by a locally installed PostgreSQL, and match it in DATABASE_URL.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://zass:zass_dev_password@localhost:5433/zassdelivery?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=zass:

# JWT (consumed from Milestone 2 onwards — must still be present and >=32 chars)
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string_32
JWT_REFRESH_TTL=30d

# Logging
LOG_LEVEL=debug

# Rate limiting (requests per TTL window, TTL in milliseconds)
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# CORS — comma-separated origins, or `*` for all
CORS_ORIGINS=*

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Locale / market defaults
DEFAULT_COUNTRY_CODE=+92
DEFAULT_TIMEZONE=Asia/Karachi
DEFAULT_CURRENCY=PKR

# Payments
# The URL gateways send the customer's browser and their callbacks back to.
# Must be reachable from the public internet in any environment that takes real
# payments — a gateway cannot call localhost.
PUBLIC_BASE_URL=http://localhost:3000
PAYMENT_CHECKOUT_TTL_MINUTES=15

# JazzCash — leave blank to disable. Issued by JazzCash per merchant.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_CHECKOUT_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform
JAZZCASH_API_URL=https://sandbox.jazzcash.com.pk/ApplicationAPI/API/PaymentInquiry/Inquire

# Easypaisa — leave blank to disable. Issued by Easypaisa per store.
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_CHECKOUT_URL=https://easypay.easypaisa.com.pk/easypay/Index.jsf
EASYPAISA_API_URL=https://easypay.easypaisa.com.pk/easypay-service/rest/v4
